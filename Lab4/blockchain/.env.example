# Copie este arquivo para `.env` (mesma pasta) e preencha os valores reais.
# `.env` é ignorado pelo Git (.gitignore raiz: **/.env). Nunca commite chaves privadas.

# URL RPC da rede de testes pública Sepolia.
# Pode ser obtida em provedores como Alchemy, Infura ou publicnode.com.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/SUA_API_KEY

# Chave privada de uma conta de teste usada apenas para pagar o gas do deploy
# na Sepolia. Use SOMENTE uma conta de teste sem fundos reais.
SEPOLIA_PRIVATE_KEY=0xSUA_CHAVE_PRIVADA_DE_TESTE

# Chave de API do Etherscan, usada por `npx hardhat verify` para publicar o
# código-fonte verificado dos contratos implantados na Sepolia.
# Obtenha em https://etherscan.io/apidashboard (funciona para toda a v2 da API).
ETHERSCAN_API_KEY=SUA_ETHERSCAN_API_KEY
